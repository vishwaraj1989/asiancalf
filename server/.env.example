# Local defaults only. Never put credentialed production values in this file.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/AsianCalf
# In Render, set MONGO_URI to the existing cloud database URI as a secret.
# MONGO_DNS_SERVERS is optional and only for DNS resolver troubleshooting.
# MONGO_DNS_SERVERS=192.0.2.53
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://asiancalf.com,https://www.asiancalf.com
# Optional one-time admin bootstrap. Never use a weak or reused setup secret.
# ADMIN_EMAIL=admin@example.com
# ADMIN_SETUP_SECRET=replace-with-a-long-random-one-time-secret

# Optional Resend email integration
# RESEND_API_KEY=replace-with-resend-api-key
# INQUIRY_FROM_EMAIL=AsianCalf <inquiries@your-verified-domain.com>
# INQUIRY_TO_EMAIL=owner@asiancalf.com

# Optional WhatsApp Business Cloud API integration
# WHATSAPP_ACCESS_TOKEN=replace-with-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_RECIPIENT_PHONE=919876543210
