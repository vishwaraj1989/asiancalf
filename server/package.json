{
  "name": "asianCalf-server",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "admin:ensure": "node scripts/ensureAdmin.js",
    "media:migrate:check": "node scripts/migrateUploadsToGridFS.js",
    "media:migrate:apply": "node scripts/migrateUploadsToGridFS.js --apply",
    "categories:migration:preview": "node scripts/migrateProductCategories.js",
    "categories:migration:apply": "node scripts/migrateProductCategories.js --apply",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --runTestsByPath tests/order.test.js tests/api.negative.test.js tests/workflows.integration.test.js",
    "test:all": "jest --runInBand --runTestsByPath tests/adminSetup.test.js tests/api.negative.test.js tests/auth.authorization.test.js tests/order.test.js tests/productMediaHeaders.test.js tests/upload.test.js tests/workflows.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "mongodb-memory-server": "^9.0.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.0.0"
  }
}
