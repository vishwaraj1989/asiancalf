NODE_ENV=production
# Render provides PORT automatically; do not hardcode it there.
# Paste the existing cloud MongoDB URI in Render's Environment settings.
MONGO_URI=<existing-cloud-mongodb-uri>
JWT_SECRET=<generate-a-long-random-secret>
CLIENT_URL=https://asiancalf.com,https://www.asiancalf.com
# Optional only when a DNS SRV resolver issue requires custom resolvers.
# MONGO_DNS_SERVERS=<comma-separated-dns-server-addresses>
